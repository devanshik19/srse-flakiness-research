#!/bin/bash
# run_od_generic.sh v2 -- sweep + REPLAY-CONFIRM gate. INSIDE container, cwd=/app/source.
# Env: MODULE, GEN (fq.Class#method), N (default 100), REPLAYS (default 5).
# Emits: SWEEP_RESULT=pass=.. fail=.. missing=.. total=.. verdict=.. confirmed=..
# Verdict logic (learned from the dubbo false-positive):
#   NOT_OD   : no order ever failed the generated test
#   OD       : at least one failing order REPRODUCES (fails >= ceil(0.6*REPLAYS) on replay) AND some order passes
#   FLAKY_ND : orders failed in the sweep but NONE reproduce on replay -> non-deterministic flakiness, NOT order-dependence
# Ordering runs on container-default Maven 3.8.6 + custom surefire.
set -uo pipefail
MODULE="${MODULE:?}"; GEN="${GEN:?}"; N="${N:-100}"; REPLAYS="${REPLAYS:-5}"
MVNOPTIONS="-Ddependency-check.skip=true -Dgpg.skip=true -DfailIfNoTests=false -Dcheckstyle.skip -Drat.skip -Denforcer.skip -Danimal.sniffer.skip -Dmaven.javadoc.skip -Dspotless.check.skip=true"
OUT=/app/source/flaky-result-od; ORDERDIR=/app/source/.od-orders
GEN_CLASS="${GEN%%#*}"; GEN_METHOD="${GEN##*#}"
mkdir -p "$OUT/testlog" "$ORDERDIR"; rm -f "$ORDERDIR"/order-*.txt; rm -f "$OUT/od-detection-results.csv"

echo ">> [1/4] compile + enumerate + baseline (testorder)"
mvn -pl "$MODULE" test-compile $MVNOPTIONS > "$OUT/testlog/compile.log" 2>&1 || { echo "!! test-compile failed"; exit 1; }
CLASSES=$(cd "$MODULE/target/test-classes" && find . -name "*Test.class" ! -name '*$*' | sed 's|^\./||; s|/|.|g; s|\.class$||' | paste -sd,)
[ -z "$CLASSES" ] && { echo "!! no *Test.class"; exit 1; }
echo "   $(echo "$CLASSES" | tr ',' '\n' | wc -l) test classes"
find "$MODULE" -name "TEST-*.xml" -delete 2>/dev/null
mvn -pl "$MODULE" test -Dsurefire.runOrder=testorder -Dtest="$CLASSES" $MVNOPTIONS > "$OUT/testlog/baseline.log" 2>&1 || true
ls "$MODULE/target/surefire-reports"/TEST-*.xml >/dev/null 2>&1 || { echo "!! baseline no reports"; exit 1; }

echo ">> [2/4] build testlist"
python3 - "$MODULE/target/surefire-reports" "$GEN" > "$OUT/testlist.txt" 2>/dev/null <<'PY'
import sys, glob, os
from xml.etree import ElementTree as ET
d, gen = sys.argv[1], sys.argv[2]; tests=[]
for fp in glob.glob(os.path.join(d,"TEST-*.xml")):
    try: root=ET.parse(fp).getroot()
    except Exception: continue
    for tc in root.findall("testcase"):
        c=tc.get("classname"); n=tc.get("name")
        if not c or not n or "[" in n or "[" in c: continue
        tests.append(f"{c}#{n}")
tests=sorted(set(tests))
if gen not in tests: tests.append(gen)
print("\n".join(tests))
PY
NT=$(wc -l < "$OUT/testlist.txt"); echo "   testlist has $NT tests"
[ "$NT" -lt 2 ] && { echo "!! testlist <2"; exit 1; }
grep -qx "$GEN" "$OUT/testlist.txt" || { echo "!! generated test $GEN not in baseline testlist"; exit 1; }

echo ">> [3/4] generate $N class-shuffled orders"
python3 - "$OUT/testlist.txt" "$ORDERDIR" "$N" <<'PY'
import sys, os, random
from collections import OrderedDict
tl, outdir, n = sys.argv[1], sys.argv[2], int(sys.argv[3])
tests=[l.strip() for l in open(tl) if l.strip() and "#" in l]
g=OrderedDict()
for t in tests: g.setdefault(t.split("#",1)[0],[]).append(t)
rng=random.Random(42); w=len(str(n))
for i in range(1,n+1):
    cs=list(g.keys()); rng.shuffle(cs)
    order=[x for c in cs for x in g[c]]
    open(os.path.join(outdir,f"order-{i:0{w}d}.txt"),"w").write("\n".join(order)+"\n")
print(f"   wrote {n} orders over {len(g)} classes")
PY

run_order(){ local of="$1" tag="$2" abs; abs="$(readlink -f "$of")"
  find "$MODULE" -name "TEST-*.xml" -delete 2>/dev/null
  mvn -pl "$MODULE" test -Dsurefire.runOrder=testorder -Dtest="$abs" $MVNOPTIONS > "$OUT/testlog/mvn-$tag.log" 2>&1
  local f=""
  while IFS= read -r file; do
    if grep -Pq "<testcase[^>]*\bclassname=\"$GEN_CLASS\"[^>]*\bname=\"$GEN_METHOD\"" "$file" || \
       grep -Pq "<testcase[^>]*\bname=\"$GEN_METHOD\"[^>]*\bclassname=\"$GEN_CLASS\"" "$file"; then f="$file"; break; fi
  done < <(find "$MODULE" -name "TEST-*.xml")
  [[ -z "$f" ]] && { echo "missing"; return; }
  python python-scripts/parse_surefire_report.py "$f" 0 "$GEN" 2>/dev/null | head -n1 | cut -d, -f2 | tr -d '[:space:]'; }

echo ">> [4/4] sanity on order-001"
first=$(ls "$ORDERDIR"/order-*.txt | head -1); exp=$(wc -l < "$first")
r1=$(run_order "$first" "sanity"); got=$(grep -oP 'Tests run: \K[0-9]+' "$OUT/testlog/mvn-sanity.log" | tail -1)
echo "   order lists $exp, maven ran ${got:-0}, gen result=$r1"
if [[ -z "$got" || "$got" -lt $((exp/2)) ]]; then echo "!! SANITY FAILED: ran ${got:-0}/$exp"; exit 2; fi

echo ">> sweeping $N orders"
RES="$OUT/od-detection-results.csv"; echo "order,result" > "$RES"
declare -a FAILORDERS=(); pass=0; fail=0; miss=0; tot=0
for of in "$ORDERDIR"/order-*.txt; do
  name=$(basename "$of" .txt); res=$(run_order "$of" "$name"); [[ -z "$res" ]] && res=missing
  echo "$name,$res" >> "$RES"; tot=$((tot+1))
  case "$res" in
    pass) pass=$((pass+1));;
    failure|error) fail=$((fail+1)); FAILORDERS+=("$of");;
    *) miss=$((miss+1));;
  esac
done
echo "   sweep raw: pass=$pass fail=$fail missing=$miss total=$tot"

# ---- REPLAY-CONFIRM: only a reproducibly-failing order counts as real OD ----
verdict=NOT_OD; confirmed=0
if [[ "$fail" -gt 0 ]]; then
  echo ">> replay-confirm: re-running up to 5 failing orders x$REPLAYS to test reproducibility"
  need=$(( (REPLAYS*6+9)/10 ))   # ceil(0.6*REPLAYS)
  RC="$OUT/replay-confirm.csv"; echo "order,replay_fails,replays" > "$RC"
  n_checked=0
  for of in "${FAILORDERS[@]}"; do
    [[ $n_checked -ge 5 ]] && break; n_checked=$((n_checked+1))
    rf=0
    for k in $(seq 1 "$REPLAYS"); do
      r=$(run_order "$of" "replay-$(basename "$of" .txt)-$k")
      { [[ "$r" == "failure" || "$r" == "error" ]]; } && rf=$((rf+1))
    done
    echo "$(basename "$of" .txt),$rf,$REPLAYS" >> "$RC"
    echo "   $(basename "$of" .txt): failed $rf/$REPLAYS on replay"
    [[ "$rf" -ge "$need" ]] && confirmed=$((confirmed+1))
  done
  if   [[ "$confirmed" -gt 0 && "$pass" -gt 0 ]]; then verdict=OD
  elif [[ "$confirmed" -gt 0 && "$pass" -eq 0 ]]; then verdict=CONSISTENT_FAIL
  else verdict=FLAKY_ND
  fi
fi
echo "SWEEP_RESULT=pass=$pass fail=$fail missing=$miss total=$tot verdict=$verdict confirmed=$confirmed"
